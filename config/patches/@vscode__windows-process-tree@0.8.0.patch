+void GetProcessCreationTime(ProcessInfo& process_info) {
+  HANDLE hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, process_info.pid);
+  if (hProcess == NULL) {
+    return;
+  }

+  FILETIME creationTime, exitTime, kernelTime, userTime;
+  if (GetProcessTimes(hProcess, &creationTime, &exitTime, &kernelTime, &userTime)) {
+    ULARGE_INTEGER value;
+    value.LowPart = creationTime.dwLowDateTime;
+    value.HighPart = creationTime.dwHighDateTime;
+    // FILETIME is 100ns intervals since 1601; JavaScript dates use Unix ms.
+    constexpr ULONGLONG windowsEpochMs = 11644473600000ULL;
+    const ULONGLONG fileTimeMs = value.QuadPart / 10000ULL;
+    if (fileTimeMs >= windowsEpochMs) {
+      process_info.creationTimeMs = fileTimeMs - windowsEpochMs;
+    }
+  }

+  CloseHandle(hProcess);
+}
